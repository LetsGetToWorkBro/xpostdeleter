# Copy to `.dev.vars` for local development (`wrangler dev`).
# In production these are secrets: `wrangler secret put NAME`.
# `.dev.vars` is git-ignored — never commit real values.

# ---- Required ---------------------------------------------------------------
# Signs the session cookie. Any long random string.
#   openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-plus-random-characters

# AES-256-GCM key for encrypting OAuth tokens at rest. MUST decode to 32 bytes.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-me-with-base64-of-32-random-bytes

# ---- X / Twitter (optional) --------------------------------------------------
# Only needed if you want to offer a shared app. By default each user brings
# their own Client ID through the UI, which is the recommended setup: rate
# limits and any pay-per-use charges then sit on their own developer account.
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# ---- Facebook Pages (optional) -----------------------------------------------
# Meta app with the "Facebook Login" product. Enables the Pages cleanup flow.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ---- Threads (optional) ------------------------------------------------------
# Meta app with the "Threads API" use case, including the threads_delete
# permission. This is a *separate* app id from the Facebook one.
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# ---- Supabase (entirely optional) --------------------------------------------
# Mirrors job history so it outlives the 30-day session. The app works fine
# without it — jobs live in Durable Objects either way.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
